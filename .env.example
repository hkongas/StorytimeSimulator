# xAI Grok API-avain (ensisijainen suositus)
XAI_API_KEY=your_xai_api_key_here

# Azure AI / Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_DEPLOYMENT_NAME=gpt-5.6-terra

# Vaihtoehtoiset rajapinnat (valinnainen)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Oletuspalveluntarjoaja: xai, azure, openai, openrouter tai custom
LLM_PROVIDER=xai

# Kertojan / Pääagentin malliasetukset (Director & Novelist)
DIRECTOR_MODEL=grok-2-latest
DIRECTOR_MAX_TOKENS=128000
DIRECTOR_TEMPERATURE=0.45
DIRECTOR_REASONING_EFFORT=low
DIRECTOR_PLAN_TEMPERATURE=0.4
DIRECTOR_PLAN_MAX_TOKENS=64000
DIRECTOR_PLAN_REASONING_EFFORT=low
PROSE_TEMPERATURE=0.8
PROSE_REASONING_EFFORT=medium
STORY_INIT_TEMPERATURE=0.8
STORY_INIT_REASONING_EFFORT=medium

# Hahmoagenttien malliasetukset (Character Agents)
CHARACTER_MODEL=grok-2-latest
CHARACTER_MAX_TOKENS=64000
CHARACTER_TEMPERATURE=0.75
CHARACTER_REASONING_EFFORT=low

# Kevyt tilanneohjain (tyhjä malli käyttää CHARACTER_MODEL-asetusta)
SITUATION_MODEL=
SITUATION_MAX_TOKENS=16384
SITUATION_TEMPERATURE=0.4
SITUATION_REASONING_EFFORT=low
# Ajurin päätös-, kutsu-, hahmo-, aika- ja kokonaistokenrajat
SITUATION_DECISION_LIMIT=12
SITUATION_CALL_LIMIT=8
SITUATION_CHARACTER_LIMIT=4
SITUATION_TIME_LIMIT_SECONDS=120
SITUATION_TOKEN_LIMIT=128000

# Rajattu pelaajanäkymä
PLAYER_VIEW_TEMPERATURE=0.8
PLAYER_VIEW_MAX_TOKENS=64000
PLAYER_VIEW_REASONING_EFFORT=low

# Täydet promptit/vastaukset sisältävät tarinan salaisuuksia; oletuksena pois
LLM_CALL_CONTENT_LOGGING=false
LLM_CALL_RETENTION_DAYS=30

# Palvelinasetukset
PORT=8000
HOST=127.0.0.1
