# xAI Grok API-avain (ensisijainen)
XAI_API_KEY=your_xai_api_key_here

# Vaihtoehtoiset rajapinnat (valinnainen)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Oletuspalveluntarjoaja: xai, openai, openrouter tai custom
LLM_PROVIDER=xai

# Oletusmallit
# xAI: grok-2-latest, grok-beta, grok-vision-beta
# OpenAI: gpt-4o, gpt-4o-mini
# OpenRouter: mikä tahansa tuettu malli
DIRECTOR_MODEL=grok-2-latest
CHARACTER_MODEL=grok-2-latest

# Palvelinasetukset
PORT=8000
HOST=127.0.0.1
