# xAI Grok API-avain (ensisijainen suositus)
XAI_API_KEY=your_xai_api_key_here

# Azure AI / Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_DEPLOYMENT_NAME=gpt-5.6-terra

# Vaihtoehtoiset rajapinnat (valinnainen)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Oletuspalveluntarjoaja: xai, azure, openai, openrouter tai custom
LLM_PROVIDER=xai

# Kertojan / Pääagentin malliasetukset (Director & Novelist)
DIRECTOR_MODEL=grok-2-latest
DIRECTOR_MAX_TOKENS=3500
DIRECTOR_TEMPERATURE=0.85
DIRECTOR_REASONING_EFFORT=medium

# Hahmoagenttien malliasetukset (Character Agents)
CHARACTER_MODEL=grok-2-latest
CHARACTER_MAX_TOKENS=600
CHARACTER_TEMPERATURE=0.75
CHARACTER_REASONING_EFFORT=low

# Palvelinasetukset
PORT=8000
HOST=127.0.0.1
